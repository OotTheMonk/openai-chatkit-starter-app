# =============================================================================
# SWU Stats OAuth Configuration
# =============================================================================
# Copy this file to .env and fill in your credentials.
# Register your application at https://swustats.net to get OAuth credentials.

# OAuth Client Credentials (required for OAuth)
# Get these by registering your app at SWU Stats
SWUSTATS_CLIENT_ID=your_client_id_here
SWUSTATS_CLIENT_SECRET=your_client_secret_here

# OAuth Scope - permissions your app is requesting
# Available scopes: openid, profile, decks (check SWU Stats docs for current list)
SWUSTATS_OAUTH_SCOPE=openid+profile+decks+editdecks

# Chat model keys (for the UI model selector).
# OpenAI models (GPT-4o, GPT-4o Mini): https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_key_here
# Meta Llama models via api.llama.com (separate Meta billing).
# LLAMA_API_KEY=your_llama_key_here
# OpenRouter free models (GPT-OSS 120B, Qwen3 Coder, plus the Free Router).
# Get one at https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_openrouter_key_here

# =============================================================================
# ngrok Configuration (for local development)
# =============================================================================
# If you're using ngrok for local OAuth development:
# 1. Create a free account at https://ngrok.com
# 2. Get your auth token from https://dashboard.ngrok.com/auth
# 3. Add it here to avoid ngrok rate limits and get a static domain

# Optional: ngrok authentication token
# If not set, you can also run: ngrok config add-authtoken <your-token>
NGROK_AUTHTOKEN=

# =============================================================================
# ngrok Configuration (for local development)
# =============================================================================
# If you're using ngrok for local OAuth development:
# 1. Create a free account at https://ngrok.com
# 2. Get your auth token from https://dashboard.ngrok.com/auth
# 3. Add it here to avoid ngrok rate limits and get a static domain

# Optional: ngrok authentication token
# If not set, you can also run: ngrok config add-authtoken <your-token>
NGROK_AUTHTOKEN=

# =============================================================================

# Server host and port for local development
SERVER_HOST=localhost
SERVER_PORT=8000

# Base URL for the server (used to construct redirect URI)
# For local development with automatic ngrok: This will be auto-updated by dev_run.py
# For manual setup: Use your ngrok URL (e.g., https://abc123.ngrok.io)
# For production: Set this to your deployed domain (e.g., https://myapp.example.com)
SERVER_BASE_URL=http://localhost:8000

# OAuth Redirect URI
# This MUST match exactly what you registered with SWU Stats
# For local development: Will be auto-set by dev_run.py to {ngrok_url}/oauth/callback
# For production: https://your-domain.com/oauth/callback
# SWUSTATS_REDIRECT_URI=http://localhost:8000/oauth/callback

# =============================================================================
# Development Setup
# =============================================================================
# When using python dev_run.py for development:
# - ngrok will be automatically started if needed
# - This file will be updated with the correct URLs
# - Don't manually set NGROK_URL (it's auto-managed)
# NGROK_URL=

# =============================================================================
# Production Configuration
# =============================================================================
# When deploying to production, update these values:
#
# 1. Set SERVER_BASE_URL to your production domain:
#    SERVER_BASE_URL=https://your-app.example.com
#
# 2. Update your SWU Stats app registration with the production redirect URI:
#    SWUSTATS_REDIRECT_URI=https://your-app.example.com/oauth/callback
#
# 3. Make sure to keep your client secret secure and never commit it to git!
# 4. Remove or comment out NGROK_URL if present

# =============================================================================
# Legacy Configuration (deprecated)
# =============================================================================
# If you have an existing access token and don't want to use OAuth yet,
# you can set it here. This is deprecated and will be removed in the future.
# SWUSTATS_ACCESS_TOKEN=your_legacy_token_here

# =============================================================================
# API Configuration (usually don't need to change)
# =============================================================================
# SWUSTATS_API_BASE=https://swustats.net/TCGEngine/APIs
