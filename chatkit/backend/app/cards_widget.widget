{
  "version": "1.0",
  "name": "card_search_results",
  "template": "{\"type\":\"ListView\",\"limit\":7,\"children\":[{\"type\":\"ListViewItem\",\"key\":\"header\",\"children\":[{\"type\":\"Box\",\"width\":\"100%\",\"padding\":{\"x\":3,\"y\":2},\"children\":[{\"type\":\"Col\",\"gap\":1,\"children\":[{\"type\":\"Text\",\"value\":\"Card matches\",\"size\":\"lg\",\"weight\":\"bold\"},{\"type\":\"Text\",\"value\":{{ ((\"Search: \" ~ query ~ \" (\" ~ (count | string) ~ \" found)\")) | tojson }},\"size\":\"sm\",\"color\":\"tertiary\"}]}]}]},{\"type\":\"ListViewItem\",\"key\":\"cards\",\"children\":[{\"type\":\"CardGrid\",\"children\":[{% for card in cards %}{% if card.id %}{\"type\":\"CardImage\",\"key\":{{ (loop.index | string) | tojson }},\"id\":{{ card.id | tojson }},\"name\":{{ card.name | tojson }}{% if card.image %},\"image\":{{ card.image | tojson }}{% endif %}}{% else %}{\"type\":\"Text\",\"value\":{{ card.name | tojson }},\"size\":\"sm\"}{% endif %}{{ \",\" if not loop.last }}{% endfor %}]}]}]}",
  "jsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1
      },
      "count": {
        "type": "integer",
        "minimum": 0
      },
      "cards": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": ["string", "null"]
            },
            "image": {
              "type": ["string", "null"]
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "query",
      "count",
      "cards"
    ],
    "additionalProperties": false
  }
}
