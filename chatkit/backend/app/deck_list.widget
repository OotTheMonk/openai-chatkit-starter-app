{
  "version": "1.0",
  "name": "deck_list",
  "template": "{\"type\":\"ListView\",\"limit\":6,\"children\":[{\"type\":\"ListViewItem\",\"key\":\"header\",\"children\":[{\"type\":\"Box\",\"width\":\"100%\",\"padding\":{\"x\":3,\"y\":1},\"children\":[{\"type\":\"Col\",\"gap\":1,\"children\":[{\"type\":\"Text\",\"value\":\"Your deck collection\",\"size\":\"lg\",\"weight\":\"bold\"},{\"type\":\"Text\",\"value\":{{ ((count | string) ~ \" deck\" ~ (count != 1 and \"s\" or \"\") ~ \" saved\") | tojson }},\"size\":\"sm\",\"color\":\"tertiary\"}{%- if active_deck_id -%},{\"type\":\"Text\",\"value\":{{ (\"Active: \" ~ active_deck_name) | tojson }},\"size\":\"sm\",\"color\":\"accent\",\"weight\":\"medium\"}{%- endif -%}]}]}]}{%- for deck in decks -%},{\"type\":\"ListViewItem\",\"key\":{{ (deck.id | string) | tojson }},\"children\":[{\"type\":\"Box\",\"width\":\"100%\",\"padding\":{\"x\":3,\"y\":1},\"border\":{\"top\":{\"color\":\"#e2e7dc\",\"size\":1}},\"children\":[{\"type\":\"Row\",\"gap\":2,\"align\":\"center\",\"children\":[{%- if deck.is_favorite -%}{\"type\":\"Text\",\"value\":\"\u2605\",\"color\":\"#a48b4c\",\"size\":\"sm\"},{%- endif -%}{%- if deck.is_active -%}{\"type\":\"Text\",\"value\":\"\u25b6\",\"size\":\"sm\",\"color\":\"accent\"},{%- endif -%}{\"type\":\"Col\",\"gap\":1,\"flex\":1,\"children\":[{\"type\":\"Text\",\"value\":{{ (deck.name) | tojson }},\"size\":\"sm\",\"weight\":{{ (deck.is_active and \"bold\" or \"medium\") | tojson }}},{\"type\":\"Text\",\"value\":{{ (deck.is_favorite and \"Favorite\" or \"Saved in SWUStats\") | tojson }},\"size\":\"xs\",\"color\":\"tertiary\"}]},{\"type\":\"Button\",\"label\":{{ ((deck.is_active and \"Active\" or \"Open deck\")) | tojson }},\"size\":\"sm\",\"variant\":{{ ((deck.is_active and \"soft\" or \"outline\")) | tojson }},\"disabled\":{{ (deck.is_active) | tojson }},\"onClickAction\":{\"type\":\"select_deck\",\"payload\":{\"deck_id\":{{ deck.id }},\"deck_name\":{{ (deck.name) | tojson }}}}}]}]}]}{%- endfor -%},{ \"type\":\"ListViewItem\",\"key\":\"all-decks\",\"children\":[{\"type\":\"Button\",\"label\":{{ (\"View all \" ~ count ~ \" decks\") | tojson }},\"variant\":\"outline\",\"onClickAction\":{\"type\":\"view_library\",\"payload\":{}}}]}]}",
  "jsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "count": {
        "type": "integer",
        "minimum": 0
      },
      "active_deck_id": {
        "type": [
          "integer",
          "null"
        ]
      },
      "active_deck_name": {
        "type": [
          "string",
          "null"
        ]
      },
      "decks": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "integer"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "is_favorite": {
              "type": "boolean"
            },
            "is_active": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "name",
            "is_favorite",
            "is_active"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "count",
      "decks"
    ],
    "additionalProperties": false
  }
}